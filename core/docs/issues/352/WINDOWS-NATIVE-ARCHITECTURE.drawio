<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="native-commit" name="Native Commit"><mxGraphModel dx="1100" dy="620" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="620"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="LayerFS 纯 Windows：真实文件操作 → Overlay → Commit（诊断实证范围）" style="text;html=0;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1030" height="45" as="geometry"/></mxCell><mxCell id="legend" value="绿色：复用现有真实组件　蓝色：本机原生接线/验证　黄色：未合格范围；不代表产品发布" style="text;html=0;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="67" width="1030" height="28" as="geometry"/></mxCell><mxCell id="win" value="普通 Windows 进程&#10;文件 API：读写 / 截断 / 改名 / 删除&#10;打开描述符跨两次 Commit" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="220" height="90" as="geometry"/></mxCell><mxCell id="host" value="WinFsp 原生回调&#10;C++ 薄适配 + 窄 C ABI&#10;无 C++ 文件字节后端" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="220" height="90" as="geometry"/></mxCell><mxCell id="ws" value="Rust Workspace / Overlay&#10;真实 SQLite MEMORY / OFF&#10;已有公共端口与句柄所有权" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#16803c;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="550" y="110" width="230" height="90" as="geometry"/></mxCell><mxCell id="control" value="显式 Commit 控制&#10;每个指令一次尝试，不重放&#10;诊断 capture 先独立释放" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="220" height="90" as="geometry"/></mxCell><mxCell id="captured" value="commit_captured&#10;固定 locally published frontier&#10;CapturedNamespace 构造" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#16803c;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="290" y="290" width="220" height="90" as="geometry"/></mxCell><mxCell id="save" value="Content → Storage Save&#10;复用 canonical 构造与编码&#10;Save::finish 完成对象闭合" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#16803c;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="550" y="290" width="230" height="90" as="geometry"/></mxCell><mxCell id="history" value="History → 本地 Install&#10;真实 Commit；via=Workspace&#10;推进 base，保留打开句柄" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#16803c;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="230" height="90" as="geometry"/></mxCell><mxCell id="store" value="单一全局 Store&#10;Windows NTFS / SQLite&#10;Disposable / WAL / OFF" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#16803c;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="230" height="90" as="geometry"/></mxCell><mxCell id="check" value="独立重开 + 二次挂载&#10;两版本字节、长度、父子关系&#10;UpToDate 不新增 Commit" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="470" width="230" height="90" as="geometry"/></mxCell><mxCell id="limits" value="未合格范围：不要从局部活证外推&#10;目录/嵌套已实证；桥 mutex 串行；并发写 / Commit、映射未验证&#10;同Store二次挂载已实证；完整仓库、产品SDK与崩溃恢复未合格" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3cd;strokeColor=#b7791f;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="750" height="90" as="geometry"/></mxCell><mxCell id="e0" edge="1" parent="1" source="win" target="host" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="host" target="ws" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" edge="1" parent="1" source="ws" target="store" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" edge="1" parent="1" source="control" target="captured" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" edge="1" parent="1" source="captured" target="save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" edge="1" parent="1" source="save" target="history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" edge="1" parent="1" source="history" target="store" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" edge="1" parent="1" source="history" target="check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#475569;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
